@startuml Usecase

skinparam dpi 300
left to right direction

actor "Recruteur" as Recruiter
actor "Candidat" as Candidate

rectangle "HiringForge" {

    ' ============================================================
    ' OFFRES D'EMPLOI
    ' ============================================================

    (Consulter les offres d'emploi) as ConsultJobOfferList
    (Consulter une offre d'emploi) as ConsultJobOffer
    (Filtrer les offres) as FilterJobOffer

    FilterJobOffer ..> ConsultJobOfferList : <<extend>>


    ' ============================================================
    ' PROFIL CANDIDAT
    ' ============================================================

    (Modifier les informations personnelles) as ModifyCandidateInformation
    (Modifier l'adresse) as ModifyCandidateAddress
    (Importer un CV) as ImportCV


    ' ============================================================
    ' CANDIDATURE
    ' ============================================================

    (Postuler à une offre d'emploi) as ApplyJobOffer


    ' ============================================================
    ' CANDIDATURES - RECRUTEUR
    ' ============================================================

    (Consulter les candidatures) as ConsultCandidateList
    (Consulter une candidature) as ConsultCandidate
    (Filtrer les candidatures) as FilterCandidate

    FilterCandidate ..> ConsultCandidateList : <<extend>>

    (Sélectionner les candidats) as CandidateSelection


    ' ============================================================
    ' ENTRETIENS
    ' ============================================================

    (Planifier un entretien) as PlanInterview
    (Accepter un entretien) as AcceptInterview
    (Refuser un entretien) as RejectInterview


    ' ============================================================
    ' PROPOSITION D'EMBAUCHE
    ' ============================================================

    (Générer une proposition d'embauche) as GenerateHiringOffer
    (Accepter ou refuser une proposition d'embauche) as RespondToHiringOffer


    ' ============================================================
    ' PROFIL RECRUTEUR
    ' ============================================================

    (Modifier les informations personnelles du recruteur) as ModifyUserInformation
    (Modifier les informations de l'entreprise) as ChangeCompanyInformation
    (Modifier les identifiants de connexion) as ChangeAuthCredential
    (Téléverser une vidéo de présentation) as UploadVideo


    ' ============================================================
    ' GESTION DES OFFRES
    ' ============================================================

    (Créer une offre) as CreateOffer
    (Modifier une offre) as ModifyOffer
    (Publier une offre) as PublishJobOffer
    (Modifier le statut d'une offre) as ChangeOfferStatus
    (Supprimer une offre) as DeleteJobOffer
}


' ================================================================
' CANDIDAT
' ================================================================

Candidate --> ConsultJobOfferList
Candidate --> ConsultJobOffer
Candidate --> ApplyJobOffer

Candidate --> ModifyCandidateInformation
Candidate --> ModifyCandidateAddress
Candidate --> ImportCV

Candidate --> AcceptInterview
Candidate --> RejectInterview

Candidate --> RespondToHiringOffer


' ================================================================
' RECRUTEUR
' ================================================================

Recruiter --> ConsultJobOfferList
Recruiter --> ConsultJobOffer

Recruiter --> ConsultCandidateList
Recruiter --> ConsultCandidate
Recruiter --> CandidateSelection

Recruiter --> PlanInterview
Recruiter --> GenerateHiringOffer

Recruiter --> ModifyUserInformation
Recruiter --> ChangeCompanyInformation
Recruiter --> ChangeAuthCredential
Recruiter --> UploadVideo

Recruiter --> CreateOffer
Recruiter --> ModifyOffer
Recruiter --> PublishJobOffer
Recruiter --> ChangeOfferStatus
Recruiter --> DeleteJobOffer

@enduml