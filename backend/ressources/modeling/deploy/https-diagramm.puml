@startuml
skinparam BackgroundColor white
skinparam ComponentStyle rectangle
skinparam roundcorner 10

cloud "🌐 Réseau Externe" {
    [🌍 Internet] as internet
}

node "🛡️ Gateway & Sécurité" {
    [🔒 Reverse Proxy / Web Server\n(Nginx / Traefik)] as proxy #fff3e0
}

node "🚀 Core Application" {
    [💻 Frontend / API Application] as app #e8f5e9
}

internet ==> proxy : "HTTPS (Port 443)"
proxy --> app : "HTTP / Internal Traffic"
@enduml