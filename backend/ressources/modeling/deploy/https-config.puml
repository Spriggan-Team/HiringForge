@startuml
skinparam BackgroundColor white
skinparam ComponentStyle rectangle
skinparam roundcorner 10

cloud "Internet" as internet

node "Reverse Proxy" as proxy #fff3e0
node "Frontend React" as react #e8f5e9
node "Backend Symfony" as symfony #e8f5e9

database "MariaDB" as db #f3e5f5
node "Service IA" as ia #f3e5f5
